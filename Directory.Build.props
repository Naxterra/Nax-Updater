<Project>
  <PropertyGroup>
    <Authors>Naxterra</Authors>
    <Company>Naxterra</Company>
    <Copyright>Copyright © 2026 Naxterra.</Copyright>
    <RepositoryUrl>https://github.com/Naxterra/Nax-Updater</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
