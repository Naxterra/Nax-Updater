<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>NaxUpdater-Setup-x64</OutputName>
    <OutputPath>$(MSBuildProjectDirectory)\..\artifacts\bundle\</OutputPath>
    <NaxUpdaterVersion Condition="'$(NaxUpdaterVersion)' == ''">0.15.8</NaxUpdaterVersion>
    <DefineConstants>NaxUpdaterVersion=$(NaxUpdaterVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Bundle.wxs" />
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
