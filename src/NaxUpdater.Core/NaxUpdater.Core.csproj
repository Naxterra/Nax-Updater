    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0-rc.3.26522.148" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Services/MessageCatalog.de.txt" LogicalName="NaxUpdater.Core.Services.MessageCatalog.de.txt" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NaxUpdater.Core.SmokeTests" />
